# ROM provides mosey_app / mosey_service / mosey_server types.
# customize.sh substitutes the installer's root domain before policy loading.
allow ROOT_DOMAIN mosey_service service_manager { add find };
allow ROOT_DOMAIN default_android_service service_manager { add find };
allow ROOT_DOMAIN servicemanager binder { call transfer };
allow servicemanager ROOT_DOMAIN binder { call transfer };
allow mosey_app ROOT_DOMAIN binder { call transfer };
allow mosey_app ROOT_DOMAIN fd use;
allow mosey_app mosey_service service_manager find;
allow mosey_app default_android_service service_manager find;
allow untrusted_app default_android_service service_manager find;
allow system_server default_android_service service_manager find;
allow ROOT_DOMAIN mosey_server_exec file { read open execute execute_no_trans map getattr };
allow ROOT_DOMAIN tun_device:chr_file { read write open ioctl };
